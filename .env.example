# Where the enquiry/quote form POSTs JSON.
# Formspree:  NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/<form-id>
# Cloudflare Pages + Resend (functions/api/enquiry.ts):  NEXT_PUBLIC_FORM_ENDPOINT=/api/enquiry
NEXT_PUBLIC_FORM_ENDPOINT=

# Only for functions/api/enquiry.ts (set in the Cloudflare Pages dashboard, not at build time)
# RESEND_API_KEY=
# ENQUIRY_TO=sales@prenishq.com
# ENQUIRY_FROM=PrenishQ Website <website@prenishq.com>
