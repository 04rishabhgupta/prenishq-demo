{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/products-1",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/about-1",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/events-news",
      "destination": "/about#lab",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/opal",
      "destination": "/products/opal",
      "permanent": true
    },
    {
      "source": "/agate",
      "destination": "/products/agate",
      "permanent": true
    },
    {
      "source": "/applications",
      "destination": "/technology#applications",
      "permanent": true
    },
    {
      "source": "/applications/:slug",
      "destination": "/technology/:slug",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/contact#faq",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/about#lab",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)opengraph-image",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
